# =============================================================================
# BedTrust+ IBM DB2 Configuration
# =============================================================================

# Enable DB2 integration (true / false)
USE_DB2=true

# IBM DB2 Server Connection Parameters
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=BEDTRUST
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SCHEMA=BEDTRUST

# Connection Pool Settings
DB2_POOL_SIZE=10
DB2_TIMEOUT=30

